# Copy to .env.local for local/CI test runs. NEVER commit real values.
# Local Supabase stack values come from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
# Public (publishable/anon) key - safe for browsers.
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. Used ONLY by test fixtures against local/dev databases.
# Never put this in a browser bundle, NEXT_PUBLIC_* variables, or any committed file.
SUPABASE_SERVICE_ROLE_KEY=
